{
  "$schema": "https://opencode.ai/config.json",
  "enabled_providers": ["openai", "github-copilot", "opencode"],
  "model": "openai/gpt-5.6-terra",
  "small_model": "openai/gpt-5.4-mini",
  "plugin": [
    "cc-safety-net",
    "opencode-autotitle",
    "opencode-dynamic-context-pruning",
    "opencode-log-sanitizer",
    "opencode-notify",
    "opencode-token-tracker",
    "oh-my-opencode-slim"
  ],
  "agent": {
    "explore": {
      "disable": true
    },
    "general": {
      "disable": true
    }
  },
  "lsp": true
}
