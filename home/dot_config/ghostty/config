# ── Theme ──────────────────────────────────────────────────────────────────────
theme = TokyoNight Moon

# ── Font ───────────────────────────────────────────────────────────────────────
font-family = "JetBrainsMono Nerd Font"
font-size = 10

# ── Window ─────────────────────────────────────────────────────────────────────
maximize = true
window-decoration = none
window-padding-x = 4
window-padding-y = 4

# ── Mouse ──────────────────────────────────────────────────────────────────────
mouse-hide-while-typing = true
mouse-scroll-multiplier = precision:0.5
