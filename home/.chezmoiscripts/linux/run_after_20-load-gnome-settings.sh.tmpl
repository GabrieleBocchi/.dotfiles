#!/usr/bin/env bash

set -euo pipefail

{{ if not .hasGnome -}}
echo "− Skipping GNOME settings (no gnome-shell)"
exit 0
{{ end -}}

echo "▸ Loading GNOME settings"

"{{ dir .chezmoi.sourceDir }}/scripts/render-dconf.sh" "{{ .chezmoi.sourceDir }}/dconf" | dconf load /

echo "✓ GNOME settings loaded"
