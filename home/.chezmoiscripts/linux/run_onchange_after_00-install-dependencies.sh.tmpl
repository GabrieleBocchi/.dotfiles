#!/usr/bin/env bash

set -euo pipefail

. "{{ dir .chezmoi.sourceDir }}/scripts/pkg-utils.sh"

{{ $system := fromYaml (include ".chezmoidata/system.yaml") -}}
{{ $cargo := fromYaml (include ".chezmoidata/cargo.yaml") -}}
{{ $npm   := fromYaml (include ".chezmoidata/npm.yaml") -}}

echo "▸ System packages [{{ .pm }}]"
{{ $pmData := index $system .pm -}}

# ── OS-specific repositories ────────────────────────────────────────────────
{{ range default (list) (get $pmData "copr") -}}
enable_copr {{ . }}
{{ end -}}

# ── Install base + desktop packages (PM) ────────────────────────────────────
{{ $allPkgs := concat $system.common.packages.base.pm $pmData.packages.base.pm -}}
{{ if .hasGUI }}{{ $allPkgs = concat $allPkgs $system.common.packages.desktop.pm $pmData.packages.desktop.pm }}{{ end -}}

install_pkgs {{ .pm }} {{ range $allPkgs }}{{ . }} {{ end }}

echo "✓ System packages"

# ── Script-based installs ────────────────────────────────────────────────────
{{ $allScripts := concat $system.common.packages.base.script $pmData.packages.base.script -}}
{{ if .hasGUI }}{{ $allScripts = concat $allScripts $system.common.packages.desktop.script $pmData.packages.desktop.script }}{{ end -}}

echo "▸ Script installs"

{{ range $allScripts -}}
{{ range default (list) (get . "envs") }}{{ . }} {{ end }}install_script {{ .name }} {{ .url }}{{ range default (list) (get . "args") }} {{ . }}{{ end }}
{{ end -}}

echo "✓ Script installs"

# ── Install cargo packages ──────────────────────────────────────────────────
{{ $cargoPkgs := $cargo.cargo.packages.base -}}
{{ if .hasGUI }}{{ $cargoPkgs = concat $cargoPkgs $cargo.cargo.packages.desktop }}{{ end -}}

echo "▸ cargo packages"

. "$HOME/.cargo/env"

{{ range $cargoPkgs -}}
cargo install --locked {{ . }}
{{ end -}}

echo "✓ cargo packages"

# ── Install npm global packages ─────────────────────────────────────────────
{{ $npmPkgs := $npm.npm.packages.base -}}
{{ if .hasGUI }}{{ $npmPkgs = concat $npmPkgs $npm.npm.packages.desktop }}{{ end -}}

echo "▸ npm packages"

{{ range $npmPkgs -}}
sudo npm install -g {{ . }}
{{ end -}}

echo "✓ npm packages"
