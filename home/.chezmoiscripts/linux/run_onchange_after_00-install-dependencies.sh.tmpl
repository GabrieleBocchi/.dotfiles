#!/usr/bin/env bash

set -euo pipefail

. "{{ dir .chezmoi.sourceDir }}/scripts/pkg-utils.sh"

# .chezmoidata/ data is automatically merged into the template root context

echo "▸ System packages [{{ .pm }}]"
{{ $pmData := index . .pm -}}

# ── OS-specific repositories ────────────────────────────────────────────────
{{ $allRepos := default (list) (get $pmData.base "repos") -}}
{{ if .hasGUI }}{{ $allRepos = concat $allRepos (default (list) (get $pmData.desktop "repos")) }}{{ end -}}

{{ range $allRepos -}}
enable_repo {{ $.pm }} {{ .kind }} {{ .name | quote }}{{ range $k, $v := omit . "kind" "name" }} {{ $k }}={{ $v | squote }}{{ end }}
{{ end -}}

# ── Install base + desktop packages (PM) ────────────────────────────────────
{{ $allPkgs := concat .common.base.pm $pmData.base.pm -}}
{{ if .hasGUI }}{{ $allPkgs = concat $allPkgs .common.desktop.pm $pmData.desktop.pm }}{{ end -}}
{{ if .hasGnome }}{{ $allPkgs = concat $allPkgs (default (list) (get .gnome .pm)) }}{{ end -}}

install_pkgs {{ .pm }} {{ range $allPkgs }}{{ . }} {{ end }}

echo "✓ System packages"

# ── Script-based installs ────────────────────────────────────────────────────
{{ $allScripts := concat .common.base.script $pmData.base.script -}}
{{ if .hasGUI }}{{ $allScripts = concat $allScripts .common.desktop.script $pmData.desktop.script }}{{ end -}}

echo "▸ Script installs"

{{ range $allScripts -}}
{{ range default (list) (get . "envs") }}{{ . }} {{ end }}install_script {{ .name | quote }} {{ .url }}{{ range default (list) (get . "args") }} {{ . }}{{ end }}
{{ end -}}

echo "✓ Script installs"

# ── Install cargo packages ──────────────────────────────────────────────────
{{ $cargoPkgs := .cargo.base -}}
{{ if .hasGUI }}{{ $cargoPkgs = concat $cargoPkgs .cargo.desktop }}{{ end -}}

echo "▸ cargo packages"

. "$HOME/.cargo/env"

{{ range $cargoPkgs -}}
cargo install --locked {{ . }}
{{ end -}}

echo "✓ cargo packages"

# ── Install npm global packages ─────────────────────────────────────────────
{{ $npmPkgs := .npm.base -}}
{{ if .hasGUI }}{{ $npmPkgs = concat $npmPkgs .npm.desktop }}{{ end -}}

echo "▸ npm packages"

{{ range $npmPkgs -}}
sudo npm install -g {{ . }}
{{ end -}}

echo "✓ npm packages"
