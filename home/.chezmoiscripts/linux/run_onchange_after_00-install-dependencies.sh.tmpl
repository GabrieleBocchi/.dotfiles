#!/usr/bin/env bash

set -euo pipefail

. "{{ dir .chezmoi.sourceDir }}/scripts/pkg-utils.sh"

# .chezmoidata/ data is automatically merged into the template root context

echo "▸ System packages [{{ .pm }}]"
{{ $pmData := index . .pm -}}

# ── OS-specific repositories ────────────────────────────────────────────────
{{ range default (list) (get $pmData "copr") -}}
enable_copr {{ . }}
{{ end -}}

# ── Install base + desktop packages (PM) ────────────────────────────────────
{{ $allPkgs := concat .common.packages.base.pm $pmData.packages.base.pm -}}
{{ if .hasGUI }}{{ $allPkgs = concat $allPkgs .common.packages.desktop.pm $pmData.packages.desktop.pm }}{{ end -}}

install_pkgs {{ .pm }} {{ range $allPkgs }}{{ . }} {{ end }}

echo "✓ System packages"

# ── Script-based installs ────────────────────────────────────────────────────
{{ $allScripts := concat .common.packages.base.script $pmData.packages.base.script -}}
{{ if .hasGUI }}{{ $allScripts = concat $allScripts .common.packages.desktop.script $pmData.packages.desktop.script }}{{ end -}}

echo "▸ Script installs"

{{ range $allScripts -}}
{{ range default (list) (get . "envs") }}{{ . }} {{ end }}install_script {{ .name }} {{ .url }}{{ range default (list) (get . "args") }} {{ . }}{{ end }}
{{ end -}}

echo "✓ Script installs"

# ── Install cargo packages ──────────────────────────────────────────────────
{{ $cargoPkgs := .cargo.packages.base -}}
{{ if .hasGUI }}{{ $cargoPkgs = concat $cargoPkgs .cargo.packages.desktop }}{{ end -}}

echo "▸ cargo packages"

. "$HOME/.cargo/env"

{{ range $cargoPkgs -}}
cargo install --locked {{ . }}
{{ end -}}

echo "✓ cargo packages"

# ── Install npm global packages ─────────────────────────────────────────────
{{ $npmPkgs := .npm.packages.base -}}
{{ if .hasGUI }}{{ $npmPkgs = concat $npmPkgs .npm.packages.desktop }}{{ end -}}

echo "▸ npm packages"

{{ range $npmPkgs -}}
sudo npm install -g {{ . }}
{{ end -}}

echo "✓ npm packages"
