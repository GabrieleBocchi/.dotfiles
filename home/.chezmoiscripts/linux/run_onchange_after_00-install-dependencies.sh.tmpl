#!/usr/bin/env bash

set -euo pipefail

# Nothing below needs the vault
unset BW_SESSION

. "{{ dir .chezmoi.sourceDir }}/scripts/pkg-utils.sh"

# pkg-utils.sh sha256: {{ include (joinPath (dir .chezmoi.sourceDir) "scripts/pkg-utils.sh") | sha256sum }}

# .chezmoidata/ data is automatically merged into the template root context.
# `family` (from .chezmoi.toml.tmpl) selects the family section in both
# system.yaml (packages) and repos.yaml (repositories).
{{ $family := .family -}}
{{ $pmData := default (dict) (get . $family) -}}
{{ $pmBase := default (dict) (get $pmData "base") -}}
{{ $pmDesktop := default (dict) (get $pmData "desktop") -}}

echo "▸ System packages [{{ .pm }}{{ if .family }} / {{ .family }}{{ end }}]"

# ── OS-specific repositories ────────────────────────────────────────────────
{{ $reposData := default (dict) (get .repos $family) -}}
{{ $allRepos := default (list) (get $reposData "base") -}}
{{ if .hasGUI }}{{ $allRepos = concat $allRepos (default (list) (get $reposData "desktop")) }}{{ end -}}

{{ range $allRepos -}}
enable_repo {{ $.pm }} {{ .kind }} {{ .name | quote }}{{ range $k, $v := omit . "kind" "name" }} {{ $k }}={{ $v | squote }}{{ end }}
{{ end -}}

# ── Install base + desktop packages (PM) ────────────────────────────────────
{{ $allPkgs := concat .common.base.pm (default (list) (get $pmBase "pm")) -}}
{{ if .hasGUI }}{{ $allPkgs = concat $allPkgs .common.desktop.pm (default (list) (get $pmDesktop "pm")) }}{{ end -}}
{{ if .hasGnome }}{{ $allPkgs = concat $allPkgs (default (list) (get .gnome $family)) }}{{ end -}}

install_pkgs {{ .pm }} {{ range $allPkgs }}{{ . }} {{ end }}

echo "✓ System packages"

# ── Script-based installs ────────────────────────────────────────────────────
{{ $allScripts := concat .common.base.script (default (list) (get $pmBase "script")) -}}
{{ if .hasGUI }}{{ $allScripts = concat $allScripts .common.desktop.script (default (list) (get $pmDesktop "script")) }}{{ end -}}

echo "▸ Script installs"

{{ range $allScripts -}}
{{ range default (list) (get . "envs") }}{{ . }} {{ end }}install_script {{ .name | quote }} {{ .url | squote }}{{ range default (list) (get . "args") }} {{ . | squote }}{{ end }}
{{ end -}}

echo "✓ Script installs"

# ── Install cargo packages ──────────────────────────────────────────────────
{{ $cargoPkgs := .cargo.base -}}
{{ if .hasGUI }}{{ $cargoPkgs = concat $cargoPkgs .cargo.desktop }}{{ end -}}

echo "▸ cargo packages"

. "$HOME/.cargo/env"

{{ range $cargoPkgs -}}
cargo install --locked {{ range default (list) (get . "args") }}{{ . | squote }} {{ end }}{{ .name | squote }}
{{ end -}}

echo "✓ cargo packages"

# ── Install npm packages ────────────────────────────────────────────────────
fnm_install_lts

{{ $npmPkgs := .npm.base -}}
{{ if .hasGUI }}{{ $npmPkgs = concat $npmPkgs .npm.desktop }}{{ end -}}

echo "▸ npm packages"

{{ range $npmPkgs -}}
npm install -g {{ range default (list) (get . "args") }}{{ . | squote }} {{ end }}{{ .name | squote }}
{{ end -}}

# bw now comes from scripts/password-manager.sh
if npm ls -g --depth=0 @bitwarden/cli >/dev/null 2>&1; then
    npm uninstall -g @bitwarden/cli
fi

echo "✓ npm packages"

# ── Docker API socket for podman (DOCKER_HOST in dot_zshenv) ────────────────
if [ -d /run/systemd/system ]; then
    systemctl --user enable --now podman.socket
fi
