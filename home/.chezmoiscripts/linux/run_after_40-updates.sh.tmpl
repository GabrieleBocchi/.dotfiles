#!/usr/bin/env bash

set -euo pipefail

# Nothing below needs the vault
unset BW_SESSION

# ── Antidote (zsh plugins) ──────────────────────────────────────────────────
echo "▸ Antidote update"

zsh -c '
    source "$HOME/.local/share/antidote/antidote.zsh"
    antidote bundle <"{{ .chezmoi.sourceDir }}/zsh/.zsh_plugins.txt" >/dev/null
    antidote update
'

echo "✓ Antidote update"

# ── Rust toolchain ──────────────────────────────────────────────────────────
echo "▸ Rustup update"

. "$HOME/.cargo/env"

rustup update

echo "✓ Rustup update"

# ── RTK integrations ─────────────────────────────────────────────────────────
echo "▸ RTK integrations"
if RTK_TELEMETRY_DISABLED=1 RTK_ONRAMP_DISABLED=1 rtk init -g --opencode --auto-patch; then
    echo "✓ RTK integrations"
else
    echo "⚠ RTK integrations failed" >&2
fi

# ── Flatpak apps ─────────────────────────────────────────────────────────────
echo "▸ Flatpak update"
flatpak update --user -y
echo "✓ Flatpak update"

# ── Font cache (GUI only) ───────────────────────────────────────────────────
{{ if .hasGUI -}}
echo "▸ Rebuilding font cache"

fc-cache

echo "✓ Font cache rebuilt"
{{ end -}}
