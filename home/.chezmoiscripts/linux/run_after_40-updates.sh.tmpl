#!/usr/bin/env bash

set -euo pipefail

# ── Antidote (zsh plugins) ──────────────────────────────────────────────────
echo "▸ Antidote update"

zsh -c '
    source ~/.zshrc; source $HOME/.local/share/antidote/antidote.zsh; antidote update
'

echo "✓ Antidote update"

# ── Rust toolchain ──────────────────────────────────────────────────────────
echo "▸ Rustup update"

. "$HOME/.cargo/env"

rustup update

echo "✓ Rustup update"

# ── RTK OpenCode integration ─────────────────────────────────────────────────
echo "▸ RTK OpenCode integration"
RTK_TELEMETRY_DISABLED=1 rtk init -g --opencode
echo "✓ RTK OpenCode integration"

# ── Flatpak apps ─────────────────────────────────────────────────────────────
echo "▸ Flatpak update"
flatpak update --user -y
echo "✓ Flatpak update"

# ── Font cache (GUI only) ───────────────────────────────────────────────────
{{ if .hasGUI -}}
echo "▸ Rebuilding font cache"

fc-cache

echo "✓ Font cache rebuilt"
{{ end -}}
