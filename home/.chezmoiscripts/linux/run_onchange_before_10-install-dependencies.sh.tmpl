#!/usr/bin/env bash

set -euo pipefail

. "{{ dir .chezmoi.sourceDir }}/scripts/pkg-utils.sh"

{{ $osID := .chezmoi.osRelease.id -}}

{{ if not (has $osID .supportedDistros) -}}
echo "WARNING: unsupported distribution {{ $osID }}, skipping"
exit 0
{{ end -}}

{{ $system := fromYaml (include ".chezmoidata/system.yaml") -}}

echo "▸ System dependencies [{{ $osID }}]"

# ── Common packages ─────────────────────────────────────────────────
install_pkgs {{ range $system.common }}{{ . }} {{ end }}

# ── OS-specific repositories + packages ─────────────────────────────
{{ $osPkgs := default (list) (get (index $system $osID | default (dict)) "packages") -}}
{{ $coprRepos := default (list) (get (index $system $osID | default (dict)) "copr") -}}

{{ range $coprRepos -}}
enable_copr {{ . }}
{{ end -}}

install_pkgs {{ range $osPkgs }}{{ . }} {{ end }}

echo "✓ System dependencies"

# ── npm global packages ──────────────────────────────────────────────
{{ $npm := fromYaml (include ".chezmoidata/npm.yaml") -}}
{{ $npmPkgs := concat $npm.common.packages (index $npm $osID).packages -}}

echo "▸ npm packages"

{{ range $npmPkgs -}}
sudo npm install -g {{ . }}
{{ end -}}

echo "✓ npm packages"

# ── cargo packages ────────────────────────────────────────────────────
{{ $cargo := fromYaml (include ".chezmoidata/cargo.yaml") -}}
{{ $cargoPkgs := concat $cargo.common.packages (index $cargo $osID).packages -}}

echo "▸ cargo packages"

{{ range $cargoPkgs -}}
. "$HOME/.cargo/env"
cargo install {{ . }}
{{ end -}}

echo "✓ cargo packages"
