{
  "permissions": {
    "defaultMode": "auto",
    "deny": [
      "Read(//**/.env)",
      "Read(//**/.env.local)",
      "Read(~/.ssh/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.secrets/**)",
      "Read(~/.claude/.credentials.json)",
      "Read(~/.config/gh/hosts.yml)",
      "Read(~/.local/share/opencode/auth.json)"
    ]
  },
  "theme": "dark",
  "timeFormat": "auto",
  "cleanupPeriodDays": 90,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      }
    ]
  }
}
