# git-repo and file types track main. Archive URLs are pinned by tag or SHA.

# ---- Neovim config -------------------------------------------
[".config/nvim"]
type = "git-repo"
url = "https://github.com/GabrieleBocchi/gab.lazy.git"
clone.args = ["--depth", "1"]
pull.args = ["--rebase", "--autostash"]

# ---- Tmux base config ----------------------------------------
[".config/tmux/tmux.conf"]
type = "file"
url = "https://raw.githubusercontent.com/gpakosz/.tmux/master/.tmux.conf"
refreshPeriod = "24h"

# ---- Antidote ------------------------------------------------
[".local/share/antidote"]
type = "archive"
url = "https://github.com/mattmc3/antidote/archive/refs/tags/v2.3.0.tar.gz"
stripComponents = 1

{{ if .hasGUI -}}
# ---- JetBrainsMono Nerd Font ---------------------------------
[".local/share/fonts/JetBrainsMono"]
type = "archive"
url = "https://github.com/ryanoasis/nerd-fonts/releases/download/v3.5.0/JetBrainsMono.tar.xz"
exact = true
include = ["*.ttf"]
{{ end -}}
