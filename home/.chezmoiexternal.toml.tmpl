# git-repo tracks main. File and archive URLs are pinned by tag or SHA.

# ---- Neovim config -------------------------------------------
[".config/nvim"]
type = "git-repo"
url = "https://github.com/GabrieleBocchi/gab.lazy.git"
clone.args = ["--depth", "1"]
pull.args = ["--rebase", "--autostash"]
refreshPeriod = "24h"

# ---- Tmux base config ----------------------------------------
[".config/tmux/tmux.conf"]
type = "file"
url = "https://raw.githubusercontent.com/gpakosz/.tmux/58a3dcc0d718ec0fa1c0d5a2fddd640a1ad7a5b7/.tmux.conf"

# ---- Antidote ------------------------------------------------
[".local/share/antidote"]
type = "archive"
url = "https://github.com/mattmc3/antidote/archive/refs/tags/v2.3.0.tar.gz"
stripComponents = 1

{{ if .hasGUI -}}
# ---- JetBrainsMono Nerd Font ---------------------------------
[".local/share/fonts/JetBrainsMono"]
type = "archive"
url = "https://github.com/ryanoasis/nerd-fonts/releases/download/v3.5.1/JetBrainsMono.tar.xz"
exact = true
include = ["*.ttf"]
{{ end -}}
