# Directories
export DOTFILES=$HOME/.dotfiles
export REPOS=$HOME/repos

# Docker
if command -v podman &> /dev/null && [[ -n "${XDG_RUNTIME_DIR:-}" ]]; then
    export DOCKER_HOST="unix://${XDG_RUNTIME_DIR}/podman/podman.sock"
fi

# Editor
export EDITOR=nvim
export VISUAL=nvim

# bat is named "batcat" on old Debian/Ubuntu
if command -v bat &> /dev/null; then
    export BAT_CMD=bat
elif command -v batcat &> /dev/null; then
    export BAT_CMD=batcat
fi

# Man pages
if [[ -n "${BAT_CMD:-}" ]]; then
    export MANPAGER="sh -c 'col -bx | $BAT_CMD -l man -p'"
fi

# Rust
export RUST_BACKTRACE=1

# Import secret environment variables
if [[ -f "$HOME/.secrets/.env" ]]; then
  source "$HOME/.secrets/.env"
fi

# Keep the Bitwarden session out of child processes (e.g. AI agents);
# the bw and chezmoi wrappers in aliases.zsh pass it explicitly.
if [[ -n "${BW_SESSION:-}" ]]; then
  typeset +x BW_SESSION
fi

# OpenCode local overrides
if [[ -f "$HOME/.config/opencode/opencode-local.json" ]]; then
  export OPENCODE_CONFIG="$HOME/.config/opencode/opencode-local.json"
fi
